# Copy to .env.local and fill in. Never commit .env.local.
# Found in Supabase: Project Settings > API (or printed by `supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret! Server only. Used by the player API and the admin panel.
SUPABASE_SERVICE_ROLE_KEY=

# Only used by `npm run seed:users` to create the example accounts
SEED_PASSWORD=
SUPERADMIN_EMAIL=
